# Root app — read at Next.js BUILD time only (NEXT_PUBLIC_* vars are inlined
# into the static export, never read at runtime). Not needed for local dev;
# NEXT_PUBLIC_LLM_ENDPOINT defaults to http://localhost:8787, matching
# `npm run dev:llm` (= `wrangler dev` in worker/).
# NEXT_PUBLIC_LLM_ENDPOINT=https://rag-playground-worker.<subdomain>.workers.dev

# Used by the Cloudflare CLI (`wrangler`) for KV namespace setup, deploying
# worker/, and regenerating the sample's precomputed embeddings. Create one
# at https://dash.cloudflare.com/profile/api-tokens with Workers Scripts:Edit,
# Workers KV Storage:Edit, and Workers AI:Read.
CLOUDFLARE_API_TOKEN=

# The generation Worker's own secrets (Gemini key, IP-hash salt) live in
# worker/.dev.vars — see worker/.dev.vars.example.
