{
  "compilerOptions": {
    "target": "es2022",
    "lib": ["es2022"],
    "module": "es2022",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "resolveJsonModule": true,
    "esModuleInterop": true
  },
  // worker-configuration.d.ts is generated by `npm run types` from
  // wrangler.jsonc — it supersedes @cloudflare/workers-types (which wrangler
  // now tells you to uninstall) and, more importantly, means the Env type
  // cannot silently drift from the bindings actually configured.
  "include": ["src", "worker-configuration.d.ts"]
}
